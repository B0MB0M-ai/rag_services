# Application
APP_ENV=development
LOG_LEVEL=INFO
MOCK_AI=true
SECRET_KEY=replace-with-a-long-random-demo-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# PostgreSQL / pgvector
POSTGRES_DB=repair_assistant
POSTGRES_USER=repair_app
POSTGRES_PASSWORD=repair_app_demo_password
DATABASE_URL=postgresql+asyncpg://repair_app:repair_app_demo_password@db:5432/repair_assistant

# OpenAI (server-side only; unused when MOCK_AI=true)
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG defaults (implemented in later phases)
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_VECTOR_RESULTS=12
RAG_KEYWORD_RESULTS=12
RAG_FINAL_CONTEXT_COUNT=6
RAG_MIN_EVIDENCE_SCORE=0.35
MAX_UPLOAD_SIZE_MB=20

# Browser-visible API base URL (never place secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
